# Copy to .env for local development. Change every secret before deployment.

# --- Core ---
AGENTDOCK_ENV=development
AGENTDOCK_SECRET_KEY=replace-with-at-least-32-random-characters
AGENTDOCK_ADMIN_EMAIL=admin@example.com
AGENTDOCK_ADMIN_PASSWORD=change-this-before-first-run
AGENTDOCK_DATABASE_URL=sqlite:///./agentdock.db
AGENTDOCK_STORAGE_PATH=./data/skillvault
AGENTDOCK_PUBLIC_URL=http://localhost:8000
AGENTDOCK_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AGENTDOCK_TRUSTED_PROXIES=
AGENTDOCK_SESSION_SECURE_COOKIE=false
AGENTDOCK_SESSION_DAYS=14

# --- Database pool and request protection ---
AGENTDOCK_DATABASE_POOL_SIZE=8
AGENTDOCK_DATABASE_MAX_OVERFLOW=12
AGENTDOCK_DATABASE_POOL_TIMEOUT_SECONDS=30
AGENTDOCK_REQUEST_RATE_LIMIT_PER_MINUTE=300
AGENTDOCK_AUTH_RATE_LIMIT_PER_MINUTE=12

# --- First-run behaviour ---
# Seed the original MIT-licensed AgentDock starter library and subscription plans.
AGENTDOCK_SEED_LIBRARY=true
# In production, migrations are applied by the migrate service. Keep this false.
AGENTDOCK_AUTO_MIGRATE=false

# --- GitHub ---
# Read-only token used for repository imports and automated discovery.
AGENTDOCK_GITHUB_TOKEN=
# Shared secret used to verify POST /api/v1/webhooks/github.
AGENTDOCK_GITHUB_WEBHOOK_SECRET=
# Comma-separated GitHub owners whose repositories are first-party. The importer
# marks them OWNER-AUTHORIZED so skills without a public licence can still be
# reviewed. Leave empty unless you own those repositories.
AGENTDOCK_FIRST_PARTY_OWNERS=

# --- Email delivery (SMTP) ---
# Without SMTP, verification and reset links are only returned in development
# responses and logged. Configure SMTP before enabling email verification.
AGENTDOCK_SMTP_HOST=
AGENTDOCK_SMTP_PORT=587
AGENTDOCK_SMTP_USER=
AGENTDOCK_SMTP_PASSWORD=
AGENTDOCK_SMTP_FROM=AgentDock <no-reply@agentdock.local>
AGENTDOCK_SMTP_STARTTLS=true
AGENTDOCK_REQUIRE_EMAIL_VERIFICATION=false

# --- Payments ---
# manual | paddle | flutterwave | urubutopay
# manual is a real invoice workflow: an administrator records the payment after
# the customer settles the invoice. Provider credentials activate the others.
AGENTDOCK_PAYMENT_PROVIDER=manual
AGENTDOCK_PAYMENT_CURRENCY=USD
AGENTDOCK_MANUAL_BILLING_EMAIL=billing@agentdock.local
AGENTDOCK_PLATFORM_COMMISSION_BPS=1500
AGENTDOCK_PADDLE_API_KEY=
AGENTDOCK_PADDLE_WEBHOOK_SECRET=
AGENTDOCK_PADDLE_ENVIRONMENT=sandbox
AGENTDOCK_FLUTTERWAVE_SECRET_KEY=
AGENTDOCK_FLUTTERWAVE_WEBHOOK_HASH=
AGENTDOCK_URUBUTOPAY_API_KEY=
AGENTDOCK_URUBUTOPAY_WEBHOOK_SECRET=
AGENTDOCK_URUBUTOPAY_CHECKOUT_URL=

# --- Automated GitHub discovery ---
AGENTDOCK_DISCOVERY_ENABLED=true
AGENTDOCK_DISCOVERY_INTERVAL_HOURS=24
AGENTDOCK_DISCOVERY_TOPICS=agent-skills,claude-skills,ai-agent-skills,codex-skills
AGENTDOCK_DISCOVERY_KEYWORDS=agent skills,SKILL.md
AGENTDOCK_DISCOVERY_MIN_STARS=100
AGENTDOCK_DISCOVERY_PER_PAGE=30

# --- Redis (required in production) ---
AGENTDOCK_REDIS_URL=

# --- Docker Compose only. Use URL-safe random values. ---
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-url-safe-random-value

# --- Optional S3-compatible SkillVault ---
# Use either shared S3/R2-compatible storage or the shared volume.
AGENTDOCK_S3_BUCKET=
AGENTDOCK_S3_REGION=us-east-1
AGENTDOCK_S3_ENDPOINT_URL=
AGENTDOCK_S3_ACCESS_KEY_ID=
AGENTDOCK_S3_SECRET_ACCESS_KEY=
AGENTDOCK_S3_PREFIX=agentdock
